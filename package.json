{
  "name": "mets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.{ts,tsx}\"",
    "test:coverage": "c8 --reporter=lcov --reporter=text npm test",
    "evals": "tsx --tsconfig tsconfig.json langfuse/evals/run-experiment.ts",
    "langfuse:seed-evals": "tsx --tsconfig tsconfig.json langfuse/evals/seed.ts",
    "langfuse:run-evals": "tsx --tsconfig tsconfig.json langfuse/evals/run-experiment.ts",
    "promptfoo:prepare": "tsx --tsconfig tsconfig.json promptfoo/generate-tests.ts",
    "promptfoo:prepare:full": "PROMPTFOO_FULL_SUITE=1 tsx --tsconfig tsconfig.json promptfoo/generate-tests.ts",
    "promptfoo:validate": "tsx --tsconfig tsconfig.json promptfoo/run-cli.ts validate",
    "promptfoo:eval": "tsx --tsconfig tsconfig.json promptfoo/run-cli.ts eval",
    "promptfoo:ci": "tsx --tsconfig tsconfig.json promptfoo/run-cli.ts eval --no-cache --no-progress-bar --output promptfoo/promptfoo-results.json --output promptfoo/promptfoo-results.junit.xml",
    "promptfoo:check-regression": "tsx --tsconfig tsconfig.json promptfoo/check-regression.ts",
    "promptfoo:refresh-baseline": "tsx --tsconfig tsconfig.json promptfoo/check-regression.ts --write-baseline",
    "promptfoo:view": "promptfoo view"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.130",
    "@ai-sdk/openai": "^3.0.124",
    "@ai-sdk/react": "^3.0.303",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@langfuse/client": "^6.0.0",
    "@langfuse/otel": "^5.10.2",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@supabase/supabase-js": "^2.109.0",
    "ai": "^6.0.300",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glimm": "^0.3.1",
    "jsxgraph": "^1.13.3",
    "katex": "^0.18.4",
    "mathjs": "^15.2.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadow-plugin": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "promptfoo": "^0.120.19",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
